erDiagram
    USER ||--o{ CONVERSATION : has
    USER ||--o{ GROWTH_GOAL : sets
    USER ||--o{ GROWTH_RECORD : writes
    CONVERSATION ||--|{ MESSAGE : contains
    KNOWLEDGE_DOCUMENT ||--|{ KNOWLEDGE_CHUNK : split_into

    USER {
        int id PK
        string username
        string email
        string password_hash
        string role
        datetime created_at
    }
    CONVERSATION {
        int id PK
        int user_id FK
        string title
        datetime created_at
    }
    MESSAGE {
        int id PK
        int conversation_id FK
        string role
        text content
        datetime created_at
    }
    KNOWLEDGE_DOCUMENT {
        int id PK
        string title
        string category
        int chunk_count
        string status
        datetime uploaded_at
    }
    KNOWLEDGE_CHUNK {
        int id PK
        int document_id FK
        text content
        int chunk_index
    }
    GROWTH_GOAL {
        int id PK
        int user_id FK
        string title
        string category
        string status
        date deadline
        datetime created_at
    }
    GROWTH_RECORD {
        int id PK
        int user_id FK
        int goal_id FK
        text content
        datetime record_time
    }
